{
  "executables": {
    "opencode": "opencode",
    "opencode2": "opencode2",
    "pi": "pi",
    "cursor": "cursor-agent",
    "claude": "claude",
    "codex": "codex",
    "gemini": "gemini",
    "amp": "amp"
  },
  "routing": {
    "resolverTimeoutMs": 5000,
    "resolverFailureMode": "closed",
    "circuitBreaker": {
      "failureThreshold": 3,
      "cooldownMs": 30000
    },
    "global": {
      "defaults": {
        "weights": { "quality": 4, "speed": 3, "efficiency": 3, "reliability": 4 }
      },
      "candidates": [
        {
          "id": "review-claude",
          "target": "claude",
          "route": { "provider": "anthropic", "model": "sonnet" },
          "scores": { "quality": 9, "speed": 6, "efficiency": 6, "reliability": 9 },
          "capabilities": { "readOnly": true, "write": true, "taskflow": false, "liveControl": false, "maxContextTokens": 200000 },
          "costUsd": 1.0,
          "latencyMs": 4000,
          "tags": ["deep", "review"],
          "priority": 8
        },
        {
          "id": "fast-cursor",
          "target": "cursor",
          "route": { "provider": "cursor", "model": "composer-2.5" },
          "scores": { "quality": 6, "speed": 10, "efficiency": 9, "reliability": 8 },
          "capabilities": { "readOnly": true, "write": true, "taskflow": false, "liveControl": false, "maxContextTokens": 128000 },
          "costUsd": 0.2,
          "latencyMs": 1000,
          "tags": ["fast", "cheap"],
          "priority": 5
        },
        {
          "id": "fast-pi",
          "target": "pi",
          "route": { "provider": "your-gateway", "model": "your-fast-model" },
          "scores": { "quality": 6, "speed": 10, "efficiency": 9, "reliability": 8 },
          "capabilities": { "readOnly": true, "write": true, "taskflow": true, "liveControl": true, "maxContextTokens": 128000 },
          "costUsd": 0.2,
          "latencyMs": 1000,
          "tags": ["fast", "cheap"]
        },
        {
          "id": "deep-opencode",
          "target": "opencode",
          "route": { "provider": "your-gateway", "model": "your-strong-model", "harnessVersion": "v2" },
          "scores": { "quality": 10, "speed": 5, "efficiency": 5, "reliability": 9 },
          "capabilities": { "readOnly": true, "write": true, "taskflow": true, "liveControl": true, "maxContextTokens": 256000 },
          "costUsd": 1.5,
          "latencyMs": 5000,
          "tags": ["deep", "review"]
        }
      ],
      "rules": [
        {
          "id": "canonical-muse-contributor",
          "priority": -100,
          "when": { "target": "pi", "provider": "opencode", "model": "muse-spark-1.3" },
          "apply": { "route": { "provider": "opencode-go", "model": "muse-spark-1.3-contributor" } }
        },
        {
          "id": "security-prefers-depth",
          "priority": 10,
          "when": { "taskAny": ["security", "audit", "architecture"] },
          "apply": { "weights": { "quality": 10, "speed": 1 }, "prefer": { "tags": ["deep"] } }
        },
        {
          "id": "urgent-prefers-speed",
          "priority": 20,
          "when": { "taskAny": ["urgent", "quick", "fast"] },
          "apply": { "weights": { "quality": 3, "speed": 10 }, "prefer": { "tags": ["fast"] } }
        }
      ]
    },
    "project": {
      "defaults": { "require": { "taskflow": true } }
    },
    "sessions": {
      "example-session-id": {
        "defaults": { "weights": { "quality": 8, "speed": 2 } }
      }
    },
    "resolverModule": "./harnest.routing.example.mjs",
    "options": {}
  }
}
