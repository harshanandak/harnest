{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000
    },
    "args": {
      "$ref": "#/$defs/__schema0"
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "enum": [
        "auto",
        "pi",
        "opencode",
        "claude",
        "codex",
        "cursor",
        "amp",
        "acp"
      ]
    },
    "route": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "policy": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "execution": {
      "type": "object",
      "properties": {
        "background": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "maxAgents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "prefixStaggerMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "transport": {
          "type": "string",
          "enum": [
            "oneshot",
            "session"
          ]
        },
        "providerWait": {
          "type": "object",
          "properties": {
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "maxRetries"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "source",
    "cwd"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
