{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "policy": {
      "type": "object",
      "properties": {
        "write": {
          "type": "boolean",
          "description": "Write-capable request. On guarded hosts, confirm scope and set metadata.harnest.writeApproved=true."
        },
        "tools": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "object",
              "properties": {
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                  }
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                  }
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Legacy list or exact native allow and deny names. Claude print supports both lists. Pi supports deny only. OpenCode delegates tool permissions to its server."
        },
        "mode": {
          "type": "string",
          "const": "plan",
          "description": "Cursor print only. Selects read-only plan mode regardless of write authorization."
        },
        "sandbox": {
          "type": "boolean",
          "description": "Cursor print only. True enables native isolation. False is rejected."
        },
        "maxCostUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "harnest": {
          "type": "object",
          "properties": {
            "writeApproved": {
              "type": "boolean",
              "description": "Exact guarded-host approval marker. Set true only after the lead confirms the intended write scope; there is no separate writeScope protocol field."
            }
          },
          "additionalProperties": {}
        },
        "routing": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "execution": {
      "type": "object",
      "properties": {
        "background": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "target": {
            "type": "string",
            "enum": [
              "auto",
              "pi",
              "claude",
              "codex",
              "opencode",
              "cursor",
              "amp",
              "acp"
            ]
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "route": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "description": "For ACP, use a model ID advertised by the native session."
              },
              "agent": {
                "type": "string",
                "minLength": 1,
                "description": "Claude named agent, OpenCode agent, or trusted ACP registration ID."
              },
              "variant": {
                "type": "string",
                "minLength": 1,
                "description": "For ACP, use a mode ID advertised by the native session."
              },
              "thinking": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "harnessVersion": {
                "type": "string",
                "enum": [
                  "v2"
                ]
              },
              "serverUrl": {
                "type": "string",
                "minLength": 1
              },
              "serviceTier": {
                "type": "string",
                "enum": [
                  "default",
                  "fast",
                  "priority",
                  "flex"
                ],
                "description": "One-shot only. Claude supports fast."
              },
              "profile": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$",
                "description": "Codex one-shot native config profile name."
              },
              "options": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "\\S",
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  }
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 256
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "description": "ACP session option IDs mapped to advertised values.",
                "maxProperties": 16
              }
            },
            "additionalProperties": false
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "policy": {
            "type": "object",
            "properties": {
              "write": {
                "type": "boolean",
                "description": "Write-capable request. On guarded hosts, confirm scope and set metadata.harnest.writeApproved=true."
              },
              "tools": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "allow": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                        }
                      },
                      "deny": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "Legacy list or exact native allow and deny names. Claude print supports both lists. Pi supports deny only. OpenCode delegates tool permissions to its server."
              },
              "mode": {
                "type": "string",
                "const": "plan",
                "description": "Cursor print only. Selects read-only plan mode regardless of write authorization."
              },
              "sandbox": {
                "type": "boolean",
                "description": "Cursor print only. True enables native isolation. False is rejected."
              },
              "maxCostUsd": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "metadata": {
            "type": "object",
            "properties": {
              "harnest": {
                "type": "object",
                "properties": {
                  "writeApproved": {
                    "type": "boolean",
                    "description": "Exact guarded-host approval marker. Set true only after the lead confirms the intended write scope; there is no separate writeScope protocol field."
                  }
                },
                "additionalProperties": {}
              },
              "routing": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          },
          "execution": {
            "type": "object",
            "properties": {
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400000
              },
              "sessionId": {
                "type": "string"
              },
              "addDirs": {
                "description": "Existing absolute directories for Claude, Codex, or Cursor. Codex requires write policy. External write roots require confirmed write approval.",
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1024
                }
              },
              "attachments": {
                "description": "Absolute local paths, up to 256 KiB each. Codex and Pi accept images. OpenCode and capable ACP agents accept images and files.",
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "image",
                        "file"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ],
                  "additionalProperties": false
                }
              },
              "instructions": {
                "description": "Append up to 8000 UTF-8 bytes to the Claude or Pi system prompt.",
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "sessionAction": {
                "description": "Requires sessionId. Resume is the default. Fork uses native support on Claude, Codex, OpenCode, or Pi.",
                "type": "string",
                "enum": [
                  "resume",
                  "fork"
                ]
              },
              "maxTurns": {
                "description": "Maximum Claude print-mode agentic turns.",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "target",
          "task"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    }
  },
  "required": [
    "requestId",
    "cwd",
    "nodes"
  ],
  "additionalProperties": false,
  "description": "Agent-authored DAG. Each node is a prompt-only handoff; dependencies pass attributed results. Different nodes may use different harnesses. Completed nodes are preserved during recovery.",
  "$id": "https://local.harnest/schemas/agent-graph.schema.json",
  "title": "Harnest mixed-harness DAG"
}
