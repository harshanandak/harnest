{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.harnest/schemas/handoff-request.schema.json",
  "title": "Harnest handoff request",
  "$defs": {
    "exactToolNames": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "target", "task", "cwd"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "target": { "enum": ["opencode", "pi", "cursor", "claude", "codex", "amp", "acp"] },
    "task": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "context": {},
    "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "agent": { "type": "string" },
        "variant": { "type": "string" },
        "thinking": { "type": ["string", "boolean"] },
        "harnessVersion": { "type": "string", "enum": ["v2"], "description": "OpenCode V2 is used when this field is omitted. Other targets may reject this field according to their adapter contract." },
        "serverUrl": { "type": "string", "minLength": 1, "description": "OpenCode private server URL." },
        "serviceTier": { "type": "string", "enum": ["default", "fast", "priority", "flex"], "description": "Native one-shot service tier. Claude accepts only fast." },
        "profile": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$", "description": "Codex one-shot native config profile name." },
        "options": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "pattern": "\\S", "maxLength": 128, "not": { "enum": ["__proto__", "prototype", "constructor"] } },
          "additionalProperties": { "anyOf": [{ "type": "string", "maxLength": 256 }, { "type": "boolean" }] },
          "description": "ACP session option IDs mapped to advertised values."
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "sessionId": { "type": "string" },
        "addDirs": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 1024 }, "description": "Existing absolute directories for Claude, Codex, Cursor,. Codex requires write policy. External write roots require confirmed write approval." },
        "attachments": {
          "type": "array",
          "maxItems": 4,
          "description": "Absolute local files up to 256 KiB each. Codex and Pi accept images. OpenCode and capable ACP agents accept images and files.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "enum": ["image", "file"] },
              "path": { "type": "string", "maxLength": 1024 }
            }
          }
        },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "Append up to 8000 UTF-8 bytes to the Claude or Pi system prompt." },
        "sessionAction": { "enum": ["resume", "fork"], "description": "Requires sessionId. Resume is the default. Fork uses native support on Claude, Codex, OpenCode, or Pi." },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Maximum Claude print-mode agentic turns." },
        "transport": { "enum": ["oneshot", "session"], "description": "Session transport uses the native interactive protocol; unsupported controls never silently fall back to one-shot execution." }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write": { "type": "boolean", "description": "Write-capable request. On guarded hosts, confirm scope and set metadata.harnest.writeApproved=true." },
        "tools": {
          "oneOf": [
            { "type": "array", "items": { "type": "string", "minLength": 1 } },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "allow": { "$ref": "#/$defs/exactToolNames" },
                "deny": { "$ref": "#/$defs/exactToolNames" }
              }
            }
          ]
        },
        "mode": { "const": "plan", "description": "Read-only plan mode for Cursor print requests." },
        "sandbox": { "type": "boolean", "description": "True enables Cursor's native sandbox. False is rejected." },
        "maxCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "harnest": {
          "type": "object",
          "properties": {
            "writeApproved": { "type": "boolean", "description": "Exact guarded-host approval marker. Set true only after the lead confirms the intended write scope; there is no separate writeScope protocol field." }
          }
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["auto", "pin", "prefer"] },
            "tier": { "enum": ["quick", "balanced", "deep", "review"] },
            "difficulty": { "enum": ["trivial", "bounded", "hard"] },
            "allowTrainingEndpoints": { "type": "boolean" },
            "harnessOrder": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "fallbacks": { "type": "boolean" },
            "contextTokens": { "type": "number", "minimum": 0 },
            "target": { "enum": ["opencode", "pi", "cursor", "claude", "codex", "amp", "acp"] },
            "weights": { "type": "object" },
            "route": { "type": "object" },
            "require": { "type": "object" },
            "prefer": { "type": "object" },
            "avoid": { "type": "object" },
            "maxCostUsd": { "type": "number", "minimum": 0 },
            "deadlineMs": { "type": "number", "minimum": 1 },
            "candidates": { "type": "array", "items": { "type": "object" } },
            "rules": { "type": "array", "items": { "type": "object" } },
            "defaults": { "type": "object" }
          }
        }
      }
    }
  }
}
