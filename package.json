{
  "name": "harnest",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Harnest MCP coordinates durable handoffs and workflow graphs across OpenCode, Pi, Claude Code, Codex, Cursor, Amp, and registered ACP agents.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harnest": "scripts/harnest.mjs"
  },
  "files": [
    ".agents/plugins",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor",
    ".mcp.json",
    "agents",
    "codex-agents",
    "commands",
    "docs",
    "examples",
    "hooks",
    "mcp.json",
    "monitors",
    "opencode-agents",
    "opencode-commands",
    "opencode-plugin",
    "pi-extension",
    "plugin.json",
    "schemas",
    "scripts",
    "skills",
    "src",
    "harnest.config.example.json",
    "harnest.routing.example.mjs"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "acp": "node scripts/acp-registry.mjs",
    "daemon": "node scripts/daemon.mjs",
    "routing:setup": "node scripts/setup-routing.mjs",
    "test": "node --test --test-concurrency=1",
    "test:bun": "bun test",
    "test:bun:watch": "bun test --watch",
    "check": "node --check src/mcp-server.mjs && node --test --test-concurrency=1",
    "check:bun": "bun --check src/mcp-server.mjs && bun test",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:mcp:bun": "bun scripts/smoke-mcp.mjs",
    "smoke:mcp:modern": "node scripts/smoke-mcp.mjs --modern",
    "smoke:mcp:edge": "node scripts/edge-mcp.mjs",
    "smoke:mcp:edge:modern": "node scripts/edge-mcp.mjs --modern",
    "smoke:dynamic": "node scripts/smoke-dynamic-mcp.mjs",
    "smoke:dynamic:modern": "node scripts/smoke-dynamic-mcp.mjs --modern",
    "smoke:dynamic:scale": "node scripts/dynamic-scale.mjs",
    "smoke:dynamic:runner-scale": "node scripts/dynamic-runner-scale.mjs --root .",
    "view:dynamic": "node scripts/dynamic-view.mjs",
    "smoke:harnesses": "node scripts/smoke-harnesses.mjs",
    "validate:plugin": "python scripts/vendor/codex-plugin-validator/validate_plugin.py .",
    "smoke:live-control": "node scripts/live-control-smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:bun": "bun scripts/doctor.mjs",
    "check:models": "node scripts/model-freshness.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@opencode-ai/client": "0.0.0-beta-17570",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typebox": "1.4.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshanandak/harnest.git"
  },
  "homepage": "https://github.com/harshanandak/harnest#readme",
  "bugs": {
    "url": "https://github.com/harshanandak/harnest/issues"
  }
}
